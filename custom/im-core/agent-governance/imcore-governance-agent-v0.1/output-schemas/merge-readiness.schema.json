{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "imcore-governance-agent-v0.1-merge-readiness.schema.json",
  "title": "IMCoreGovernanceAgent V0.1 Merge-Readiness Advisory Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package",
    "output_type",
    "stage",
    "advisory_only",
    "human_review_required",
    "merge_authorized_by_agent",
    "clinical_use_authorized",
    "runtime_authorized",
    "phi_or_real_patient_data_allowed",
    "repository_context",
    "merge_gate_summary",
    "required_checks",
    "safety_gates",
    "documentation_gates",
    "claim_control_gates",
    "human_review_gates",
    "recommended_decision",
    "human_decision_required"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "package": {
      "type": "string",
      "const": "IMCoreGovernanceAgent V0.1"
    },
    "output_type": {
      "type": "string",
      "const": "merge_readiness_advisory"
    },
    "stage": {
      "type": "string",
      "const": "documentation-stage-only"
    },
    "advisory_only": {
      "type": "boolean",
      "const": true
    },
    "human_review_required": {
      "type": "boolean",
      "const": true
    },
    "merge_authorized_by_agent": {
      "type": "boolean",
      "const": false
    },
    "clinical_use_authorized": {
      "type": "boolean",
      "const": false
    },
    "runtime_authorized": {
      "type": "boolean",
      "const": false
    },
    "phi_or_real_patient_data_allowed": {
      "type": "boolean",
      "const": false
    },
    "repository_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "branch",
        "working_tree_status",
        "open_pr_number",
        "head_sha",
        "context_evidence_label"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "working_tree_status": {
          "type": "string"
        },
        "open_pr_number": {
          "type": [
            "integer",
            "null"
          ]
        },
        "head_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_evidence_label": {
          "type": "string",
          "enum": [
            "repository-verified",
            "needs verification",
            "unknown"
          ]
        }
      }
    },
    "merge_gate_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merge_readiness_status",
        "blocking_conditions",
        "summary"
      ],
      "properties": {
        "merge_readiness_status": {
          "type": "string",
          "enum": [
            "ready_for_human_merge_consideration",
            "not_ready",
            "blocked",
            "needs verification"
          ]
        },
        "blocking_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "required_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks_verified",
        "failing_required_checks_count",
        "pending_required_checks_count",
        "zero_failing_required_checks",
        "zero_pending_required_checks",
        "checks_evidence_label"
      ],
      "properties": {
        "checks_verified": {
          "type": "boolean"
        },
        "failing_required_checks_count": {
          "type": "integer",
          "minimum": 0
        },
        "pending_required_checks_count": {
          "type": "integer",
          "minimum": 0
        },
        "zero_failing_required_checks": {
          "type": "boolean"
        },
        "zero_pending_required_checks": {
          "type": "boolean"
        },
        "checks_evidence_label": {
          "type": "string",
          "enum": [
            "repository-verified",
            "needs verification",
            "unknown"
          ]
        }
      }
    },
    "safety_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "no_phi",
        "no_real_patient_data",
        "no_secrets",
        "no_runtime_ai",
        "no_prompt_execution",
        "no_model_integration",
        "no_runtime_implementation",
        "no_clinical_use",
        "no_autonomous_agent_behavior"
      ],
      "properties": {
        "no_phi": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        },
        "no_real_patient_data": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        },
        "no_secrets": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        },
        "no_runtime_ai": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        },
        "no_prompt_execution": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        },
        "no_model_integration": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        },
        "no_runtime_implementation": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        },
        "no_clinical_use": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        },
        "no_autonomous_agent_behavior": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        }
      }
    },
    "documentation_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "one_pr_one_purpose",
        "changed_files_scoped",
        "source_of_truth_reviewed",
        "duplicate_document_risk_reviewed",
        "documentation_index_impact_reviewed"
      ],
      "properties": {
        "one_pr_one_purpose": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        },
        "changed_files_scoped": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        },
        "source_of_truth_reviewed": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        },
        "duplicate_document_risk_reviewed": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        },
        "documentation_index_impact_reviewed": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification",
            "not applicable"
          ]
        }
      }
    },
    "claim_control_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_claims_reviewed",
        "unsupported_readiness_claims_absent",
        "clinical_validation_claims_absent",
        "regulatory_compliance_claims_absent",
        "cybersecurity_certification_claims_absent",
        "production_readiness_claims_absent"
      ],
      "properties": {
        "material_claims_reviewed": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        },
        "unsupported_readiness_claims_absent": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        },
        "clinical_validation_claims_absent": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        },
        "regulatory_compliance_claims_absent": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        },
        "cybersecurity_certification_claims_absent": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        },
        "production_readiness_claims_absent": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        }
      }
    },
    "human_review_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_review_complete",
        "required_reviewer_roles_identified",
        "human_acceptance_recorded",
        "ai_output_treated_as_advisory_only"
      ],
      "properties": {
        "human_review_complete": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        },
        "required_reviewer_roles_identified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "human_acceptance_recorded": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "needs verification"
          ]
        },
        "ai_output_treated_as_advisory_only": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "recommended_decision": {
      "type": "string",
      "enum": [
        "GO",
        "CONDITIONAL GO",
        "NO-GO",
        "HOLD",
        "DEFER"
      ]
    },
    "human_decision_required": {
      "type": "boolean",
      "const": true
    }
  }
}
